{
  "name": "@gleanwise/widget",
  "version": "0.2.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/gleanwise-search.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gleanwise-search.esm.js"
    },
    "./iife": "./dist/gleanwise-search.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/gleanwise-search.js && esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/gleanwise-search.esm.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gleanwise/client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "esbuild": "^0.24.0",
    "vitest": "^2.1.8",
    "happy-dom": "^15.11.7"
  },
  "description": "Drop-in <gleanwise-search> web component."
}
