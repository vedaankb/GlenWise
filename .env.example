# Copy to .env (docker compose reads it) or export in your shell. Every variable is optional except where
# marked. A variable set here is locked in the Settings page, so use these for operator-managed values and
# leave the rest to the first-run guide.

# --- Core ---------------------------------------------------------------------------------------
GLEANWISE_HOST=127.0.0.1
GLEANWISE_PORT=8787
GLEANWISE_DATA_DIR=./data
GLEANWISE_PROFILE=local            # local | server

# --- Language model (no default: pick one in the app or set it here) ------------------------------
GLEANWISE_LLM_MODEL=               # provider/model, e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4-5, ollama_chat/llama3.1
GLEANWISE_LLM_API_KEY=
GLEANWISE_LLM_API_BASE=            # self-hosted servers, e.g. http://localhost:11434 or http://localhost:1234/v1

# --- Local search models ------------------------------------------------------------------------
GLEANWISE_EMBEDDER=local           # local | litellm | hash
GLEANWISE_EMBED_MODEL=BAAI/bge-small-en-v1.5
GLEANWISE_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
GLEANWISE_OFFLINE=false            # true: never download models

# --- Search backend ------------------------------------------------------------------------------
GLEANWISE_SEARXNG_URL=http://127.0.0.1:8888
GLEANWISE_SEARXNG_MANAGED=true     # the core starts a private SearXNG installed by deploy/install.sh
SEARXNG_SECRET=               # compose only: openssl rand -hex 32 (required by docker-compose*.yml)

# --- Data -----------------------------------------------------------------------------------------
GLEANWISE_THREAD_RETENTION_DAYS=28

# --- Sharing an instance (server profile) --------------------------------------------------------
GLEANWISE_API_TOKEN=               # required by docker-compose.server.yml; generate with: gleanwise token
GLEANWISE_ALLOWED_HOSTS=           # your public host name(s), comma separated
GLEANWISE_ALLOWED_ORIGINS=         # websites allowed to embed the widget, comma separated
GLEANWISE_DATABASE_URL=            # postgresql://user:password@host:5432/db (needs the pgvector extension)
POSTGRES_PASSWORD=            # compose only; use URL-safe characters
GLEANWISE_WEBHOOK_URL=
