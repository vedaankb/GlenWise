# Build context: the repository root (see the compose files).
#   docker build -f deploy/compose/Dockerfile.core -t gleanwise-core .

# ---- web app -----------------------------------------------------------------------------------
FROM node:22-slim AS web
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages packages
COPY integrations integrations
COPY apps apps
RUN pnpm install --frozen-lockfile && pnpm run build

# ---- core --------------------------------------------------------------------------------------
FROM python:3.12-slim AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.6.0 /uv /usr/local/bin/uv

ARG EXTRAS=""
ARG WITH_BROWSER=0
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app
COPY services/core/pyproject.toml services/core/uv.lock services/core/README.md ./
COPY services/core/gleanwise ./gleanwise
RUN uv sync --frozen --no-dev ${EXTRAS}
COPY --from=web /repo/apps/web/dist /app/web
COPY deploy/searxng /app/deploy/searxng

ENV PATH="/opt/venv/bin:$PATH" \
    GLEANWISE_HOST=0.0.0.0 \
    GLEANWISE_PORT=8787 \
    GLEANWISE_DATA_DIR=/data \
    GLEANWISE_WEB_DIR=/app/web \
    PYTHONUNBUFFERED=1

# Optional headless browser for JavaScript-heavy pages: --build-arg WITH_BROWSER=1
RUN if [ "$WITH_BROWSER" = "1" ]; then playwright install --with-deps chromium; fi

RUN useradd --system --uid 10001 --create-home gleanwise && mkdir /data && chown gleanwise /data
USER gleanwise
VOLUME /data
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8787/livez', timeout=4).status == 200 else 1)"
CMD ["gleanwise", "serve"]
